	partition dCALENDARIO = calculated
		mode: import
		source =
				
				VAR MinData = MIN(fBASE[Data_NF])
				VAR MaxData = MAX(fBASE[Data_NF])
				RETURN
				ADDCOLUMNS(
				    FILTER(
				        CALENDARAUTO(),
				        [Date] >= MinData && [Date] <= MaxData
				    ),
				    "Ano", YEAR([Date]),
				    "Mês", MONTH([Date]),
				    "Nome do Mês", UPPER(FORMAT([Date],"mmmm","PT-BR")),
				    "Mês Abrev",FORMAT([Date],"mmm"),
				    "Trimestre",  QUARTER([Date]) & " TRI " & "- " & YEAR([Date]),
				    "Semestre", IF(MONTH([Date]) <= 6, "1º Semestre", "2º Semestre"),
				    "Dia",DAY([Date]),
				    "DiasSemana", WEEKNUM( [Date], 1 ),
				    "DiasSemanaNome",SWITCH(
				        WEEKDAY([Date]),
				        1,"Domingo",
				        2,"Segunda",
				        3,"Terça",
				        4,"Quarta",
				        5,"Quinta",
				        6,"Sexta",
				        7,"Sabado"),
				    "Ano-Mes",FORMAT([Date],"mmm","PT-BR")&"-"&RIGHT(YEAR([Date]),2),
				    "AnoMesOrdem", YEAR( [Date] )*100 + MONTH([Date]),
				    "MesAtual", IF( YEAR( [Date] ) = YEAR( TODAY() ) && MONTH( [Date] ) = MONTH( TODAY() ), "S", "N" ),
				    "AnoTEXT", FORMAT( YEAR( [Date] ), "" ),
				    "Vencidos?", IF( [Date] < TODAY() -2 , "Vencidas", "A Vencer" ),
				    "DiaMES", FORMAT([Date],"dd","PT-BR")&"-"&FORMAT([Date],"mmm","PT-BR")
				)

	annotation PBI_Id = 3213937c286046139f560bdaa3bb2811

