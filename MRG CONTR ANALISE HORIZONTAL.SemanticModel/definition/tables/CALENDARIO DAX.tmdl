	partition 'CALENDARIO DAX' = calculated
		mode: import
		source = ```
				
				var minAno = YEAR(MIN(TB_REAL2025[xDATA]))
				var MaxAno = YEAR(MAX(TB_FatosDRE[DATA_NF])) 
				RETURN
				ADDCOLUMNS(
				    FILTER(
				        CALENDARAUTO(),
				        YEAR([Date]) >= minAno &&
				        YEAR([Date]) <= MaxAno),
				        "Ano", YEAR([Date]),
				        "AnoText", FORMAT( YEAR( [Date] ), "" ),
				        "Mês", MONTH([Date]),
				        "Nome do Mês", FORMAT([Date],"mmmm","PT-BR"),
				        "Mês Abrev",UPPER(LEFT(FORMAT([Date], "mmm"), 1)) & LOWER(RIGHT(FORMAT([Date], "mmm"), 2)),
				        "trimestre", CONCATENATE(QUARTER([Date]),"-Trimestre"),
				        "semestre", SWITCH(
				                        TRUE(),
				                        MONTH([Date]) IN{1,2,3,4,5,6}, "1-Sem",
				                        "2-Sem"),
				        "Dia",DAY([Date]),
				        "Dia/Mes", FORMAT([Date],"dd-mmm") ,
				        "DiasSemana",SWITCH(
				            WEEKDAY([Date]),
				            1,"Domingo",
				            2,"Segunda",
				            3,"Terça",
				            4,"Quarta",
				            5,"Quinta",
				            6,"Sexta",
				            7,"Sabado"),
				        "Mes Atual", IF( YEAR( [Date] ) = YEAR( TODAY() ) && MONTH( [Date] ) = MONTH( TODAY() ), "S", "N" ),
				        "Ano-Mes", UPPER(LEFT(FORMAT([Date], "mmm"), 1)) & LOWER(RIGHT(FORMAT([Date], "mmm"), 2)) & "-" & YEAR( [Date] ),
				        "OrderBy", (YEAR( [Date] )*100) + MONTH( [Date] ),
				        "Numerosemana", WEEKNUM( [Date],1),
				        "DiasUteis", IF( WEEKDAY( [Date] ) IN { 1,7 }, "N", "S" )
				    )
				```

	annotation PBI_Id = dfb0ef8dda7a44afa85920966c090401

