table MEDIDAS
	lineageTag: 88ea907e-1c68-4be5-8efb-2c8923bd93ad

	measure '1. REC BRT' =
			CALCULATE(
			    SUM(fBASE[Valor_Venda]),
			    fBASE[Operacao]=
			    "Saidas"
			)
		formatString: #,0
		lineageTag: 525a17d0-d3b2-4931-adbe-1184b33c4ce2

	measure '1.1 DVL' =
			
			VAR _VLR =
			    CALCULATE(
			        SUM(fBASE[Valor_Venda]),
			        fBASE[Operacao] = "Entradas"
			    )
			RETURN
			    IF(ISBLANK(_VLR), 0, _VLR)
		formatString: #,0
		lineageTag: 970a9636-f100-4d8a-8387-d3a80472702a

	measure '3.1 COMISSOES' =
			
			VAR _ENTRADAS = CALCULATE(
			    SUM(fBASE[Valor_Comissao]),
			    fBASE[Operacao]="Entradas")
			VAR _SAIDAS = CALCULATE(
			        SUM(fBASE[Valor_Comissao]),
			        fBASE[Operacao]="Saidas")
			RETURN
			
			_SAIDAS-_ENTRADAS
		formatString: #,0
		lineageTag: 4364f586-9c3f-453a-a7db-928423ee9c4b

	measure '3.2 FRETES' =
			
			VAR _SAIDAS = CALCULATE(
			    SUM(fBASE[Frete]),
			    fBASE[Operacao]="Saidas")
			RETURN
			_SAIDAS
		formatString: #,0
		lineageTag: 8caeb880-0c5a-4648-aa21-2dfa0f58aace

	measure '3.3 VERB FIXA' =
			CALCULATE(
			    SUM(fBASE[Verba_Fixa]),
			    fBASE[Operacao]="Saidas"
			)
		formatString: #,0
		lineageTag: 9ba655c5-a4c9-4974-be2c-2dabced4ec5c

	measure '3.4 VERB VAR' =
			CALCULATE(
			    SUM(fBASE[Verba_Variavel]),
			    fBASE[Operacao]="Saidas"
			)
		formatString: #,0
		lineageTag: 9701cff5-8629-4a5c-b3a9-62f3d13c8493

	measure '3.5 BONIFICAÇÃO' =
			
			VAR _SAIDAS = CALCULATE(
			    SUM(fBASE[Valor_CPV_Bonif]),
			    fBASE[Operacao]="Saidas"
			)
			VAR _ENTRADAS = CALCULATE(
			    SUM(fBASE[Valor_CPV_Bonif]),
			    fBASE[Operacao]="Entradas"
			)
			RETURN
			_SAIDAS-_ENTRADAS
		formatString: #,0
		lineageTag: c7333332-17df-449a-b10b-211e9f2f538a

	measure '1.2 IMP' =
			
			CALCULATE(
			    SUM(fBASE[Total_Impostos]),
			    fBASE[Operacao]="Saidas")-
			CALCULATE(
			    SUM(fBASE[Total_Impostos]),
			    fBASE[Operacao]="Entradas")
		formatString: #,0
		lineageTag: 78e6bd53-eff9-46e0-a42a-4be5681c71a7

	measure '1.3 CPV' =
			
			CALCULATE(
			    SUM(fBASE[CPV_Item_Venda]),
			    fBASE[Operacao]="Saidas")-
			CALCULATE(
			    SUM(fBASE[CPV_Item_Venda]),
			    fBASE[Operacao]="Entradas")+
			CALCULATE(
			    SUM(fBASE[CPV_Proc_Fixo]),
			    fBASE[Operacao]="Saidas")
		formatString: #,0
		lineageTag: 05e8ad2b-370f-4e3c-8581-904a27ccff2b

	measure '2 MRG BRT' = [1. REC BRT] - [1.1 DVL] - [1.2 IMP] - [1.3 CPV]
		formatString: #,0
		lineageTag: b66e1b50-439b-4601-88d0-ace5e6f80d78

	measure '3. DESP VAR' = [3.1 COMISSOES] + [3.2 FRETES] + [3.5 BONIFICAÇÃO]
		formatString: #,0
		lineageTag: aa3fed94-d94e-489f-a4a3-2ead9903b558

	measure '4. MRG CTRB' = [2 MRG BRT] - [3. DESP VAR] - [5.1 VERBAS]
		formatString: #,0
		lineageTag: 5487aa35-e6f9-44bc-afda-593e447b5155

	measure '5.1 VERBAS' = [3.3 VERB FIXA] + [3.4 VERB VAR]
		formatString: #,0
		lineageTag: 39110a6c-4ae4-487a-ae9b-571ba6b80a6e

	measure '5.3 % MRG CONT' =
			
			IF(
			    [1. REC BRT] = 0,
			    0,
			    DIVIDE([4. MRG CTRB], [1. REC BRT])
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 0bb84c94-e56d-4f80-bb25-4ac1169ff937

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

	measure '5.2 % MRG BRT' =
			
			IF(
			    [1. REC BRT] = 0,
			    0,
			    DIVIDE([2 MRG BRT], [1. REC BRT])
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 4f321a36-5b6c-4988-8152-c78d6821903e

	measure '0. FILTRO DEFINIDO' = ```
			
			VAR _GER =
			    IF(
			        ISFILTERED(fBASE[Gerente_Regional]),
			        CONCATENATEX(
			            VALUES(fBASE[Gerente_Regional]),
			            fBASE[Gerente_Regional],
			            ", "
			        ),
			        "-"
			    )
			
			VAR _KEY =
			    IF(
			        ISFILTERED(fBASE[Key_Account]),
			        CONCATENATEX(
			            VALUES(fBASE[Key_Account]),
			            fBASE[Key_Account],
			            ", "
			        ),
			        "-"
			    )
			
			VAR _SUP =
			    IF(
			        ISFILTERED(fBASE[Supervisor]),
			        CONCATENATEX(
			            VALUES(fBASE[Supervisor]),
			            fBASE[Supervisor],
			            ", "
			        ),
			        "-"
			    )
			
			VAR _REP =
			    IF(
			        ISFILTERED(fBASE[Representante]),
			        CONCATENATEX(
			            VALUES(fBASE[Representante]),
			            fBASE[Representante],
			            ", "
			        ),
			        "-"
			    )
			
			VAR _UF =
			    IF(
			        ISFILTERED(fBASE[UF]),
			        CONCATENATEX(
			            VALUES(fBASE[UF]),
			            fBASE[UF],
			            ", "
			        ),
			        "-"
			    )
			
			
			VAR _TRI =
			    IF(
			        ISFILTERED(dCALENDARIO[Trimestre]),
			        CONCATENATEX(
			            VALUES(dCALENDARIO[Trimestre]),
			            dCALENDARIO[Trimestre],
			            ", "
			        ),
			        "-"
			    )
			
			VAR _MES = 
			    IF(
			        ISFILTERED(dCALENDARIO[Nome do Mês]),
			        CONCATENATEX(
			            VALUES(dCALENDARIO[Nome do Mês]),
			            dCALENDARIO[Nome do Mês],
			            ", "
			        ),
			        "-"
			    )
			
			RETURN
			_GER & " / " &
			_KEY & " / " &
			_SUP & " / " &
			_REP & " / " &
			_UF & " / " &
			_MES & " / " &
			_TRI
			
			
			```
		lineageTag: 0fcb9735-904f-4c34-920e-be44c374d129

	column Value
		isHidden
		formatString: 0
		lineageTag: ab49470c-b4c1-4ace-a85e-37d04beed21f
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition MEDIDAS = calculated
		mode: import
		source = {0}

	annotation PBI_Id = 18dbc781035b4e62ad008d846707b8a0

