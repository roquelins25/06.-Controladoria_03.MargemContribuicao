	measure '02. 8 - MRG CTRB' =
			
			// Margem de Contribuicao
			VAR _MargemBruta = [02. 3 - MRG BRT]
			VAR _DespVariavel = [02. 5 - OTRS DESP VAR]
			VAR _Verbas = [03. 07 - Verbas ( R$ )]
			
			RETURN
			_MargemBruta - _DespVariavel - _Verbas
