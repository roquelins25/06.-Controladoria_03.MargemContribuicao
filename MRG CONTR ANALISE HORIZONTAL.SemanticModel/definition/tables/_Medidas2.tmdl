	measure '03. Linha Maxima Grafic' = ```
			
			
			VAR _SELECT = SELECTEDVALUE( DRE_LV1[ID] )
			VAR _MAX = 
			CALCULATE(
			    MAXX(
			        FILTER(
			            SUMMARIZECOLUMNS(
			                DRE_LV1[ID],
			                'CALENDARIO DAX'[Ano-Mes],
			                "@Total", [00.DRE DRE] ),
			            DRE_LV1[ID] = _SELECT ),
			        [@Total] ) ,
			    ALL( 'CALENDARIO DAX' )
			)
			RETURN
			IF(
			   ISBLANK( [00.DRE DRE] ), BLANK(),
			        ( _MAX * 0.3 ) + _MAX
			) 
