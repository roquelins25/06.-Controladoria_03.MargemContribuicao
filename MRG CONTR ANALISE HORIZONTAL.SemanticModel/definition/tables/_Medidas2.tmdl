	measure '02. 7 - VERBAS' = ```
			
			// calcula verbas fixas e variaveis 
			VAR _FIXAS = 
			    CALCULATE( [01.DRE Total Verbas Fixas], 'DRE_Geral - Plan'[Operacao] = "Saidas" )
			VAR _VARIAVEIS = 
