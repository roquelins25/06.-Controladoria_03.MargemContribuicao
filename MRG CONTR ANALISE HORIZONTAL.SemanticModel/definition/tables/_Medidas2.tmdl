			VAR _BONIFICACOES =
			    VAR vBONISAIDAS = CALCULATE( [01.DRE CPV Bonificacao], 'DRE_Geral - Plan'[Operacao] = "Saidas" )
			    VAR vBONIENTRAD = CALCULATE( [01.DRE CPV Bonificacao], 'DRE_Geral - Plan'[Operacao] = "Entradas" )
			    RETURN
