table _Medidas2
	lineageTag: 4748875b-4f08-4356-875e-456556170049

	measure '01.DRE Total Valor Bruto ( R$ )' =
			
			SUM( 'DRE_Geral - Plan'[Valor_Venda] )
		displayFolder: 01. Totais
		lineageTag: 59854924-32d9-4a34-941e-184f314c6a07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '02. 1 - REC BRT' =
			
			// Receita Bruta
			CALCULATE(
			    [01.DRE Total Valor Bruto ( R$ )],
			    'DRE_Geral - Plan'[Operacao] = "Saidas" )
		displayFolder: 02. Auxiliares Vertical
		lineageTag: d4745ebc-59a3-4c12-8f65-e52fc15c7d84

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '02. 2 - DVL' =
			
			// Devolucao
			CALCULATE(
			    [01.DRE Total Valor Bruto ( R$ )],
			    'DRE_Geral - Plan'[Operacao] = "Entradas" )
		displayFolder: 02. Auxiliares Vertical
		lineageTag: 0e6dcf04-53f9-4b32-b17a-73e46b510ea9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '02. 3 - MRG BRT' = ```
			
			// Margem Bruta
			VAR _RECEITA =  [02. 1 - REC BRT]
			
			VAR _DEVOLUCAO =  [02. 2 - DVL]
			
			VAR _IMPOSTO = 
			    VAR vIMPSAIDAS = CALCULATE( [01.DRE Total Impostos ( R$ )],  'DRE_Geral - Plan'[Operacao] = "Saidas" )
			    VAR vIMPENTRAD = CALCULATE( [01.DRE Total Impostos ( R$ )], 'DRE_Geral - Plan'[Operacao]  = "Entradas" )
			    RETURN
			    vIMPSAIDAS - vIMPENTRAD
			
			VAR _CPV = 
			    VAR vCPVSAIDAS = CALCULATE( [01.DRE Total CPV ItemVenda], 'DRE_Geral - Plan'[Operacao]  = "Saidas" )
			    VAR vCPVENTRAD = CALCULATE( [01.DRE Total CPV ItemVenda], 'DRE_Geral - Plan'[Operacao]  = "Entradas" )
			    VAR vCPVFIXOSA = CALCULATE( [01.DRE Total CPV Fixo], 'DRE_Geral - Plan'[Operacao]  = "Saidas" )
			    RETURN
			    vCPVSAIDAS -  vCPVENTRAD + vCPVFIXOSA 
			
			VAR vTOTAL = _RECEITA - _DEVOLUCAO - _IMPOSTO  - _CPV 
			
			RETURN
			vTOTAL
			```
		displayFolder: 02. Auxiliares Vertical
		lineageTag: 0d81b036-f819-4c16-979d-d6d0e26d7304

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '01.DRE Total Impostos ( R$ )' =
			
