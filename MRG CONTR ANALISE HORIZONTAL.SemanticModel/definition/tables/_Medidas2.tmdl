	measure '03. 01 - Grafico Rotulo TOPO' = ```
			
			VAR _SELECT = SELECTEDVALUE( DRE_LV1[ID] )
			VAR _ALL =
			CALCULATE(
			    [00.DRE DRE],
			    DRE_LV1[ID] = _SELECT,
			    ALL( 'xTabela RMC Data' )
			)
			RETURN
			DIVIDE( 
			    CALCULATE(
			        [00.DRE DRE],
			        DRE_LV1[ID] = _SELECT),
			_ALL , 0 )
