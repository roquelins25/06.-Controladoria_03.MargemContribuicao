	measure '03. 09 - Margem Contribuicao ( % )' = ```
			
			// calculado encima da receita bruta 
			DIVIDE( [03. 08 - Margem Contribuicao ( R$ )], [02. Receita Operacional Bruta ( R$ )], 0 )
			```
		formatString: 0.0%;-0.0%;0.0%
