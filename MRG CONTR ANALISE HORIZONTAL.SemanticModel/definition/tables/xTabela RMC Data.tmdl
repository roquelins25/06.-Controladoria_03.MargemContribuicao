		annotation SummarizationSetBy = Automatic

	partition 'xTabela RMC Data' = calculated
		mode: import
		source = ```
				
				VAR _ANO = 
				ADDCOLUMNS(
				    DISTINCT(
				    SELECTCOLUMNS(
				        'CALENDARIO DAX',
				        'CALENDARIO DAX'[Ano] ) ),
				    "Mês Abrev", BLANK(),
				    "Mês", 'CALENDARIO DAX'[Ano] * 100 ,
				    "Periodo", CONCATENATE("YTD ", 'CALENDARIO DAX'[Ano] ),
				    "Cod. Periodo", 2 )
				
				VAR _MES = 
				ADDCOLUMNS(
				    DISTINCT(
				    SELECTCOLUMNS(
				        'CALENDARIO DAX',
				        'CALENDARIO DAX'[Ano-Mes],
				        'CALENDARIO DAX'[Mês Abrev],
				        'CALENDARIO DAX'[Mês] ) ),
				    "Periodo", 'CALENDARIO DAX'[Mês Abrev] ,
				    "Cod. Periodo", 1 )
				
				VAR _meta = 
				ROW(
				    "Ano-Mes", 2026,
				    "Mês Abrev", BLANK(),
				    "Mês", 9999999 ,
				    "Periodo", "Orça.",
				    "Cod. Periodo", 3 )
				
				VAR _Previ = 
				ROW(
				    "Ano-Mes", BLANK(),
				    "Mês Abrev", BLANK(),
				    "Mês", 99999999 ,
				    "Periodo", "Prev.",
				    "Cod. Periodo", 4 )
				
				VAR _PM = 
				ROW(
				    "Ano-Mes", BLANK(),
				    "Mês Abrev", BLANK(),
				    "Mês", 999999999 ,
				    "Periodo", "Preço Médio",
				    "Cod. Periodo", 5 )
				
				
				RETURN
				UNION(_MES,_ANO,_meta)
				
				```

	annotation PBI_Id = 4dc24bffd4a043f0b7265b614c4d758f

