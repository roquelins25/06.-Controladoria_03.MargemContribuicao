/// Devolve o formato (texto) por tipo: 1 R$ compacto sem casas (K/M/B, multiplos de 1000); 2 R$ compacto 2 casas; 3 R$ centavos; 4 R$ inteiro; 5 percentual; 6 R$ inteiro com sinal apos R$; 7 numero inteiro.
function fxFormatNumber =
		( xNumber : SCALAR VAL, xTipo : INT64 ) =>
		        SWITCH(
		            xTipo,
		            1, "R$ #,0;-R$ #,0",          -- compacto: só vale em fxFORMAT
		            2, "R$ #,0;-R$ #,0",          -- compacto: só vale em fxFORMAT
		            3, "R$ #,0.00;-R$ #,0.00",
		            4, "R$ #,0;-R$ #,0",
		            5, "0.0%;-0.0%",
		            6, "R$ #,0;R$ -#,0",
		            7, "#,0;-#,0",
		            8, "R$ #,0;(R$ #,0)"
		        )
	lineageTag: 7a7258f4-d5b3-41b0-bdba-24d655f66e94

function fxFORMAT =
		( xNumber : SCALAR VAL, xTipo : INT64 ) =>
		        IF(
		            ISBLANK( xNumber ), BLANK(),
		            SWITCH(
		                xTipo,
		                1, fxFormatCompacto( xNumber, 0 ),
		                2, fxFormatCompacto( xNumber, 1 ),
		                9, _FormatDre( xNumber, 1 ),
		                FORMAT( xNumber, fxFormatNumber( xNumber, xTipo ), "pt-BR" )
		            )
		        )
	lineageTag: d7dceae9-836a-424e-8d63-ff2e4cbd8cc1

function fxFormatCompacto =
		( xNumber : SCALAR VAL, xDec : INT64 ) =>
		        VAR _abs   = ABS( xNumber )
		        VAR _casas = IF( xDec > 0, "." & REPT( "0", xDec ), "" )
		        VAR _fmt   = "R$ #,0" & _casas & ";-R$ #,0" & _casas
		        VAR _usaM  = _abs >= 1000000 || ROUND( _abs / 1000, xDec ) >= 1000
		        VAR _usaK  = _abs >= 1000
		        RETURN
		        IF(
		            ISBLANK( xNumber ), BLANK(),
		            SWITCH(
		                TRUE(),
		                _usaM, FORMAT( xNumber / 1000000, _fmt, "pt-BR" ) & "M",
		                _usaK, FORMAT( xNumber / 1000,    _fmt, "pt-BR" ) & "K",
		                FORMAT( xNumber, "R$ #,0;-R$ #,0", "pt-BR" )
		            )
		        )
	lineageTag: f183d9ca-3ad9-4205-947b-81e4b97b38c1

function _FormatDre =
		( xNumber : SCALAR VAL, xDec : INT64 ) =>
		        VAR _abs   = ABS( xNumber )
		        VAR _casas = IF( xDec > 0, "." & REPT( "0", xDec ), "" )
		        VAR _fmt   = "R$ #,0" & _casas
		        VAR _usaM  = _abs >= 1000000 || ROUND( _abs / 1000, xDec ) >= 1000
		        VAR _usaK  = _abs >= 1000
		        VAR _txt   =
		            SWITCH(
		                TRUE(),
		                _usaM, FORMAT( _abs / 1000000, _fmt, "pt-BR" ) & "M",
		                _usaK, FORMAT( _abs / 1000,    _fmt, "pt-BR" ) & "K",
		                FORMAT( _abs, "R$ #,0", "pt-BR" )
		            )
		        RETURN
		        IF( ISBLANK( xNumber ), BLANK(), IF( xNumber < 0, "(" & _txt & ")", _txt ) )
	lineageTag: f5484f75-63de-422d-aa7b-803d31e6b350

